# Copy to jarvis.toml and edit. Every option here is optional - the values shown
# are the defaults. Anything can also be set with an environment variable, e.g.
# JARVIS_STT_BACKEND or JARVIS_TTS_ENGINE, and command line flags beat both.

log_level = "INFO"

[audio]
# device_index = 1    # leave unset for the system default, or use `jarvis --list-devices`
# Hard cap on one phrase, only reached when noise is unbroken enough that the
# phrase never ends on silence at all. High, because being cut off mid sentence
# is worse than waiting - pause_quiet_fraction is what avoids the wait.
phrase_time_limit = 60.0
# How a buffer is judged to be speech. "silero" scores each 32ms frame with a
# 1.2MB network, so a footstep as loud as a word still scores near zero and
# cannot hold a phrase open. "energy" is loudness alone, which cannot tell them
# apart. "auto" uses silero and falls back to energy if it will not load.
vad = "auto"
# Silero's cutoff for deciding speech has started. Lower hears more.
vad_threshold = 0.35
# Once speaking, how far the score may dip before it counts as a pause. Silero's
# own implementation does this; without it a quiet consonant reads as silence.
vad_hysteresis = 0.15
# Least speech that counts as a phrase rather than a noise. This is measured in
# real speech, so it is stricter than it looks - at 0.3 short answers like "no"
# and "stop" were dropped without trace.
min_speech_seconds = 0.15
# The rest of this section is energy mode only - silero ignores loudness.
calibration_seconds = 1.5
dynamic_energy_threshold = true
# energy_threshold = 300  # set this to skip calibration entirely
# Floor under the calibrated threshold. Lower means more sensitive: if you have
# to speak up to be heard, drop this. Raise it if JARVIS starts hearing itself,
# though the echo guard should catch that first.
min_energy_threshold = 55.0
# Non-speech that ends a phrase. The main thing to change if you keep getting
# cut off mid sentence, and the floor under how long before the agent sees you.
pause_threshold = 1.2
# Noise allowed inside the pause without restarting it. 0.85 tolerates about
# 0.32s of clicks or a distant voice per pause, and does not shorten the pause
# itself. Lower tolerates a noisier room, at the cost of ending on your own
# hesitations - measured, 0.8 cut twice as many sentences short for 0.06s more.
pause_quiet_fraction = 0.85
# How long after JARVIS stops talking the microphone stays ignored. Covers the
# output buffer draining and the room's echo tail. Raise it in a live room, but
# note that a reply starting inside this window is dropped.
echo_guard_seconds = 0.5
# Half duplex by default: the microphone is muted while JARVIS speaks. Turn this
# on to keep listening through a reply, which allows barging in - but with one
# microphone and no echo cancellation the only thing stopping JARVIS answering
# itself is the text comparison in echo.py. Leave it off if you use speakers.
listen_while_speaking = false

[stt]
# whisper runs on this machine. google is free and needs no model download, but
# it uploads every captured phrase to Google - it is opt in for that reason.
backend = "whisper"
language = "en-GB"
whisper_model = "base.en"      # tiny.en, base.en, small.en, medium.en, large-v3
# Measured on base.en with 5s of speech: cpu 0.32s and no VRAM, cuda 0.09s and
# 339MB. Most of that VRAM is the CUDA context, not the model, so a smaller
# model saves little. The pipeline delay is dominated by pause_threshold, so
# cpu is the default - switch to "auto" only if the GPU is otherwise idle, and
# install the runtime with: uv sync --extra cuda
whisper_device = "cpu"         # cpu | cuda | auto
whisper_compute_type = "default"
whisper_beam_size = 1          # 1 is greedy and fastest, raise for accuracy
whisper_vad = true             # skip silence before transcribing

[tts]
# auto means sapi, the offline Windows voice. edge sounds far better but sends
# every reply to Microsoft, so it has to be named explicitly.
engine = "auto"                # auto | sapi | edge | none
# Preference order, first installed wins. Both are female - Hazel is en-GB and
# usually the Windows default, Zira is en-US. For a British male, George ships as
# a OneCore voice only: run scripts/expose-onecore-voices.ps1 (elevated) to let
# SAPI see it, then name it first here. `-List` shows what you have.
sapi_voice = "Hazel, Zira"
voice = "en-GB-RyanNeural"     # edge only, `edge-tts --list-voices` for more
rate = 210                     # words per minute. SAPI steps coarsely: ~205+ is
                               # one notch faster than default, ~265+ is two.
volume = 1.0

[service]
# The voice service an agent connects to (`jarvis serve`). Loopback only - there
# is no auth, so do not bind this to anything routable.
host = "127.0.0.1"
port = 8770
# Longest a single converse() call may block. Keep it under the agent's own
# tool timeout (Cline's is around 60s) so the agent re-calls rather than erroring.
max_wait_seconds = 55.0
transcript_file = "heard.jsonl"
# Past this, an utterance is flagged to the agent as backlog rather than a live
# request. 0 disables the flag.
stale_after_seconds = 120.0
# Key that stops and starts listening, from anywhere. Empty disables it. The hook
# is global and does not swallow the keypress, so whatever is chosen still does
# its normal job everywhere else - Num Lock still flips the keypad. Any spelling
# the keyboard library accepts works: "num lock", "numlock", "num_lock".
hotkey = "num lock"
# Hand speech back as a tool *error* rather than a result, so a client will not
# let the turn end on it. A fallback for models that forget to call converse()
# and answer in chat text instead, where nothing reaches the user. Only fires
# when something was actually heard and a reply is outstanding - an idle poll
# stays a plain success. Turn it off if a client counts consecutive errors and
# gives up instead of pressing on.
force_a_reply = true

[screen]
# Seeing the desktop and acting on it. Looking is always allowed - it reads the
# accessibility tree and touches nothing. Everything that moves the real pointer
# or types on the real keyboard waits on this.
control = false
# Most targets offered at once. Past a few dozen a model stops reading the list
# and starts guessing; narrowing with matching= is the better answer.
max_targets = 60
# Older than this and a scan is refused rather than acted on. Windows move.
max_scan_age_seconds = 60.0
min_target_pixels = 6          # smaller than this is a divider, not a target
# Longest label kept per target. A chat row carries its whole last message as its
# name, and sixty of those is the prompt this was meant to shrink.
label_chars = 80
click_settle_seconds = 0.05    # pointer move to press, so hover states settle
focus_settle_seconds = 0.35    # after raising a window - restoring is animated
# Send the marked screenshot to the agent as well as the list. Without a vision
# model loaded it is a megabyte of cost for something unreadable.
send_image = false
# Where the marked screenshot goes when one is asked for, under logs/. Empty
# means never draw one for the agent's own scans - a full screen grab is ~0.5s
# and the picture is for a human. `jarvis look --marks` ignores this and always
# writes one. Needs: uv sync --extra screen
marks_file = ""
