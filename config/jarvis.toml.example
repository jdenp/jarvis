# Copy to jarvis.toml and edit. Every option here is optional - the values shown
# are the defaults. Anything can also be set with an environment variable, e.g.
# JARVIS_STT_BACKEND or JARVIS_TTS_ENGINE, and command line flags beat both.

log_level = "INFO"

[audio]
# device_index = 1    # leave unset for the system default, or use `jarvis --list-devices`
# Hard cap on one phrase, only reached when noise is unbroken enough that the
# phrase never ends on silence at all. High, because being cut off mid sentence
# is worse than waiting - pause_quiet_fraction is what avoids the wait.
phrase_time_limit = 60.0
# How a buffer is judged to be speech. "silero" scores each 32ms frame with a
# 1.2MB network, so a footstep as loud as a word still scores near zero and
# cannot hold a phrase open. "energy" is loudness alone, which cannot tell them
# apart. "auto" uses silero and falls back to energy if it will not load.
vad = "auto"
# Silero's cutoff for deciding speech has started. Lower hears more.
vad_threshold = 0.35
# Once speaking, how far the score may dip before it counts as a pause. Silero's
# own implementation does this; without it a quiet consonant reads as silence.
vad_hysteresis = 0.15
# Least speech that counts as a phrase rather than a noise. This is measured in
# real speech, so it is stricter than it looks - at 0.3 short answers like "no"
# and "stop" were dropped without trace.
min_speech_seconds = 0.15
# The rest of this section is energy mode only - silero ignores loudness.
calibration_seconds = 1.5
dynamic_energy_threshold = true
# energy_threshold = 300  # set this to skip calibration entirely
# Floor under the calibrated threshold. Lower means more sensitive: if you have
# to speak up to be heard, drop this. Raise it if JARVIS starts hearing itself,
# though the echo guard should catch that first.
min_energy_threshold = 55.0
# Non-speech that ends a phrase. The main thing to change if you keep getting
# cut off mid sentence, and the floor under how long before the agent sees you.
pause_threshold = 1.2
# Noise allowed inside the pause without restarting it. 0.85 tolerates about
# 0.32s of clicks or a distant voice per pause, and does not shorten the pause
# itself. Lower tolerates a noisier room, at the cost of ending on your own
# hesitations - measured, 0.8 cut twice as many sentences short for 0.06s more.
pause_quiet_fraction = 0.85
# How long after JARVIS stops talking the microphone stays ignored. Covers the
# output buffer draining and the room's echo tail. Raise it in a live room, but
# note that a reply starting inside this window is dropped.
echo_guard_seconds = 0.5
# Full duplex: the microphone stays open through a reply, so it can be cut off
# mid sentence. Off, because on speakers it transcribes itself - there is no echo
# cancellation here and the only defence is the text comparison in echo.py, which
# a long reply has already beaten once. On headphones there is nothing to hear,
# so turn it on there. Talking over JARVIS while it is thinking works either way;
# this only covers the seconds a reply is actually being spoken.
#
# Where it starts rather than where it stays. Headphones go on and come off
# during a day, so holding the hotkey flips it, as does the headphone button on
# the web app.
listen_while_speaking = false

[stt]
# whisper runs on this machine. google is free and needs no model download, but
# it uploads every captured phrase to Google - it is opt in for that reason.
backend = "whisper"
language = "en-GB"
whisper_model = "base.en"      # tiny.en, base.en, small.en, medium.en, large-v3
# Measured on base.en with 5s of speech: cpu 0.32s and no VRAM, cuda 0.09s and
# 339MB. Most of that VRAM is the CUDA context, not the model, so a smaller
# model saves little. The pipeline delay is dominated by pause_threshold, so
# cpu is the default - switch to "auto" only if the GPU is otherwise idle, and
# install the runtime with: uv sync --extra cuda
whisper_device = "cpu"         # cpu | cuda | auto
whisper_compute_type = "default"
whisper_beam_size = 1          # 1 is greedy and fastest, raise for accuracy
whisper_vad = true             # skip silence before transcribing

[tts]
# auto means kokoro if its model has been downloaded and sapi otherwise, both of
# which stay here. edge sounds better than sapi but sends every reply to
# Microsoft, so it has to be named explicitly.
engine = "auto"                # auto | kokoro | sapi | edge | none
# The 82M neural voice. The two files are 330MB and are fetched by hand - see the
# README - because nothing should pull that down the first time you say hello.
kokoro_voice = "bm_george"     # b* are British and a* American, which also picks
                               # the phonemes the text is read with
kokoro_model = "models/kokoro-v1.0.onnx"
kokoro_voices = "models/voices-v1.0.bin"
# About 5x real time on a modern desktop CPU against 20x on CUDA, and one
# sentence is well under a second either way - so cpu unless the GPU is idle.
# auto tries CUDA first and falls back with a line in the log, the same as
# whisper_device. cuda needs onnxruntime-gpu installed.
kokoro_device = "cpu"          # cpu | cuda | auto
# Preference order, first installed wins. Both are female - Hazel is en-GB and
# usually the Windows default, Zira is en-US. For a British male, George ships as
# a OneCore voice only: run scripts/expose-onecore-voices.ps1 (elevated) to let
# SAPI see it, then name it first here. `-List` shows what you have.
sapi_voice = "Hazel, Zira"
voice = "en-GB-RyanNeural"     # edge only, `edge-tts --list-voices` for more
rate = 210                     # words per minute. SAPI steps coarsely: ~205+ is
                               # one notch faster than default, ~265+ is two.
volume = 1.0

[service]
# The voice service (`jarvis serve`). Loopback only - there is no auth, so do
# not bind this to anything routable.
host = "127.0.0.1"
port = 8770
# Longest a single /heard may block before it returns empty. Caps the wait a
# caller asks for, so a client with its own timeout asks again rather than
# erroring.
max_wait_seconds = 55.0
transcript_file = "heard.jsonl"
# A page this service serves, so a phone can be the microphone. It adds GET / and
# the endpoints under it, and a second capture source that streams into the same
# phrase splitter the room does.
#
# On, because it opens nothing on its own: nobody off this machine can reach it
# until they put `tailscale serve` in front of it themselves, and with no browser
# open it is one idle capture source that sleeps. This stays on loopback with no
# auth, and that is the design - let Tailscale say who you are, and do not bind
# it wider instead. The browser needs the https that gives you anyway; a
# microphone is refused outright without it.
start_webapp = true
# Key that shuts this microphone, from anywhere. Empty disables it. Nothing is
# swallowed, so whatever is chosen still does its normal job everywhere else -
# Num Lock still flips the keypad. Any spelling the keyboard library accepts
# works: "num lock", "numlock", "num_lock".
#
# The three lock keys are watched rather than hooked, which is why they keep
# working with an elevated window in front. Hold one for a second and a half and
# it flips listen_while_speaking instead of shutting the microphone.
hotkey = "num lock"

[screen]
# Seeing the desktop and acting on it. Looking is always allowed - it reads the
# accessibility tree and touches nothing. This gates everything that moves the
# real pointer or types on the real keyboard. On by default: the point of the
# feature is to act, and when it is off the failure looks exactly like the
# feature being broken. Set it false for the read-only half.
control = true
# Most targets offered at once. 60 was chosen on the theory that a long list
# makes a model guess; measured against real applications it was far worse than
# that - Spotify has 166 real targets and Outlook in a browser 177, so 60 hid
# most of both, including Spotify's play button. At 200 nothing normal truncates
# at all, and when it does the cut is spread across the window rather than taken
# off the end.
max_targets = 200
# Older than this and a scan is refused rather than acted on. Windows move.
max_scan_age_seconds = 60.0
min_target_pixels = 6          # smaller than this is a divider, not a target
# Longest label kept per target. A chat row carries its whole last message as its
# name, and sixty of those is the prompt this was meant to shrink.
label_chars = 80
click_settle_seconds = 0.05    # pointer move to press, so hover states settle
focus_settle_seconds = 0.35    # after raising a window - restoring is animated
# Where `jarvis look --marks` writes the marked screenshot, under logs/. What to
# look at when a click lands somewhere unexpected. Nothing draws one
# automatically - a scan costs a full screen grab, about half a second, and the
# numbered list is what the model reads.
marks_file = "marks.png"

[brain]
# JARVIS's own agent loop. With this on it answers for itself: it hears you,
# calls a model with the desktop tools, and speaks the reply. Speaking is not a
# tool here - the model's reply IS what goes through the speakers - which is the
# whole reason it exists. See DESIGN.md.
# Any OpenAI-compatible chat endpoint. llama-server with --jinja is what this
# was built against, and --jinja is the part that parses tool calls. An endpoint
# that is not on this machine sees every word of every conversation, and the
# startup line says so.
#
# Required, and there is no switch to turn the brain off. JARVIS used to carry
# on without a model as ears and hands, which meant an unreachable endpoint
# looked exactly like a working assistant that ignored everything said to it.
# It stops and says why instead.
url = "http://127.0.0.1:8081/v1"
# How long to wait for it at startup before giving up. Both this and the model
# server usually start at login and nothing sequences them, so the ordinary case
# is JARVIS winning the race and a large model taking a minute or two to load off
# disk. It asks every five seconds and says so in the log while it waits. 0 goes
# back to failing at once. Only `jarvis serve` waits - chat mode is somebody at a
# keyboard, who is better told than left in front of a prompt that never returns.
wait_for_model_seconds = 600.0
model = "local"                # llama-server ignores it and serves what is loaded
api_key = ""                   # for an endpoint that wants one. Loopback does not.
# Low on purpose. Choosing a tool is a one-right-answer decision with no creative
# upside, and at 0.6 a plausible-but-wrong tool gets picked often enough to notice.
temperature = 0.4
# Everything one call may generate. Not just the answer: with thinking on, the
# reasoning comes out of the same allowance, and a forty word reply is nothing
# beside two thousand characters of deliberation. 600 was sized for the answer
# alone and a hard think ate all of it, stopping mid sentence with nothing left
# to say. A cap rather than a reservation, so generous costs nothing.
max_tokens = 2000
# Tool calls allowed in one turn before the loop stops and asks for the answer.
# This costs patience rather than context - somebody is waiting through every one
# - so it is the one cap not set by the token budget. Eight ran out on a real
# request: look, focus, look, click, look, type, look, check is eight with
# nothing having gone wrong, and twelve is one mistake and its recovery past
# that. The turn cannot end silent either way; the last call is made with the
# tools taken away, so prose is the only move left.
max_steps = 16
# Turns of conversation kept. Cut whole turns rather than messages - half a turn
# leaves a tool result whose call is gone, which some endpoints reject outright.
history_turns = 20
# Longest wait for one completion. Prompt processing is the slow part on a local
# model, and a large context reprocessing from cold takes most of a minute.
timeout_seconds = 180.0
# Read the reply as it is generated rather than waiting for all of it. The answer
# is spoken at the end either way; what this buys is a terminal showing the model
# think instead of a spinner, which is the difference between waiting and
# watching. Turn it off for an endpoint whose streaming is unreliable.
stream = true
# Send one throwaway request at startup, so the system prompt and the tool schemas
# are already in the server's cache when somebody first speaks. A second or two of
# nobody's time, taken off the first answer - the one that would otherwise feel
# broken. Needs a server that reuses a cached prefix; llama.cpp's --cache-reuse.
preload = true
# Let the model reason before answering. On, and the measurement is worth
# keeping: off, a greeting comes back in 0.4s rather than 2.2s - but with ten
# tools in front of it the model started writing calls as prose, so
# `search_web(query="...")` appeared where the answer should be. The loop catches
# that and asks again rather than reading it out, so this is safe to turn off; it
# costs a round trip when it happens.
thinking = true
# Searching and reading the web. THE ONLY THING IN THE DEFAULT INSTALL THAT
# LEAVES THIS MACHINE. On because there is no local equivalent - off, the feature
# does not exist. The startup line names it every time.
web = true
# DuckDuckGo's HTML endpoint, which needs no key. Somebody's page rather than
# somebody's contract, so it can change shape - point this at your own SearXNG
# for the version that cannot.
search_url = "https://html.duckduckgo.com/html/"
search_results = 5             # a screenful, and as many as are worth reading
page_chars = 6000              # an article is sentences; the rest is navigation
                               # about 1500 tokens per 3000 characters, measured
# Context window, for the meter in the corner of the terminal and for the ceiling
# below. 0 asks the server, which llama.cpp answers on /props.
context_limit = 0
# Most of the window the conversation may take up. history_turns counts turns and
# turns are not the same size: a greeting is 50 tokens and a turn that scans a
# crowded window twice is 6000, so twenty of the second kind would overflow a 98k
# window and the request would fail outright rather than degrade. Whichever of
# the two bites first wins. 0 leaves only the turn count.
max_context_fraction = 0.7
# Where the droppable half starts being emptied, as a fraction of the window.
# Droppable is reasoning and tool results; what stays is what was asked, what was
# called and what was answered. Both go oldest first, whichever comes first,
# because a thought and the scan it led to are worth the same nothing an hour
# later. 0 turns it off.
squash_fraction = 0.7
# When emptying is not enough, summarise. A fraction of the ceiling above rather
# than of the window, measured against what is left once everything droppable has
# gone: the oldest half of that becomes one paragraph of what happened, in the
# model's own words. Costs one model call on the turn it fires. 0 turns it off.
summarise_fraction = 0.8
# The shell tool, which is how anything that is not the desktop gets done -
# files, git, and a coding agent if one is named below. It runs whatever the model
# asks for, as you, with no confirmation: that is the point of it and also the
# reason it is a switch. Everything else works with it off.
shell = true
# A command line coding agent to hand real code changes to, if you have one.
# JARVIS is told to run `<this> "the whole request"` rather than editing source a
# line at a time through the shell. Empty and it is told coding is not its job.
coding_agent = ""
shell_timeout_seconds = 60.0   # a command is waited on, so an interactive one is killed
# Output kept per command, cut out of the middle. The head says what ran and the
# tail carries the error, so a prefix loses the half that mattered.
shell_output_chars = 4000
# What JARVIS writes down for itself with the remember tool, and reads back into
# its prompt at the start of every turn: how this desk behaves, and who it is
# talking to. None of it is the same on the next machine, so the list is grown
# rather than shipped. Plain markdown under headings - edit or delete any of it,
# rename the headings, add your own lines. Every markdown file under
# context/memories is read, so os-navigation.md beside it is read too.
memories = true
memories_file = "context/memories/memories.md"   # under the project root, or absolute
# Where remember() writes during a session, before the learning phase folds it
# into the file above. Deliberately not under context/memories: everything
# there goes at the front of the prompt, which is the right place for something
# that never changes and the worst place for something that changes mid turn -
# a changed front means the server reads the whole conversation again. This
# half goes at the end instead, where a change costs the tokens after it.
# Empty writes straight to the file above, the way it used to.
session_memories_file = "logs/session-memories.md"
# Once the conversation has gone quiet, JARVIS looks back over everything said
# since the last time it did and writes down whatever was worth keeping. The only
# way a lesson outlives the conversation it was learned in without somebody
# typing it up.
consolidate = true
# How long quiet is. It used to run on the end of every turn, which is a second
# model call on every single answer - most of them about nothing, because most
# turns teach nothing. A lull costs nobody anything, and the one call then sees
# what a run of turns added up to rather than one line out of the middle of it.
settle_seconds = 60.0
# How much of it is read back. This is prompt, paid on every call, so it is
# capped. Going over drops the whole file rather than quietly losing the top of
# it, and says so in red at startup. Large on purpose: the cap is here to catch a
# file that has run away, not to ration what JARVIS is allowed to know.
max_memory_chars = 20000
# Who JARVIS is. Empty means context/soul/brain.md, which is where the prompt
# lives: prose, tuned by reading it out loud and changing a word, with no copy in
# the code to drift from. Shorter is better - the more instructions it carries the
# more carelessly they are followed, which is the same lesson as the accessibility
# tree in different clothes.
system_prompt_file = ""
